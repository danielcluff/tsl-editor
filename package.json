{
  "name": "tsl-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:graph": "pnpm --dir packages/tsl-graph test",
    "graph:update": "git submodule update --remote --merge packages/tsl-graph && git -C packages/tsl-graph submodule update --init && pnpm install",
    "mcp:stdio": "TSL_GRAPH_URL=${TSL_GRAPH_URL:-http://localhost:${PORT:-5173}/mcp} tsl-graph-mcp"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.11",
    "lucide-static": "^1.48.0",
    "solid-js": "2.0.0-rc.11",
    "three": "^0.186.1",
    "tsl-graph": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
